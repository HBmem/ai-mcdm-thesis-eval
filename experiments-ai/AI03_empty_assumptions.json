{
  "schema_version": "3.0",
  "experiment_id": "AI03",
  "name": "Empty Assumptions",
  "description": "Scenario-information ablation for synthetic municipal transportation prioritization with a fixed 100-participant evidence base.",
  "purpose": "Compare AI output while holding numerical inputs and model settings fixed and varying only authored scenario information.",
  "scenario": {
    "id": "transportation_prioritization",
    "description": "Municipal transportation project selection.",
    "policy_question": "How should a municipal government prioritize transportation improvement initiatives when balancing implementation costs, public accessibility, environmental benefits, and implementation time?",
    "context": {
      "municipality": "Mid-sized city",
      "planning_horizon_years": 5,
      "background": "The municipality is experiencing population growth, increased traffic congestion, and unequal transportation access across neighborhoods.",
      "decision_scope": "Prioritization of transportation initiatives for municipal capital investment.",
      "funding_context": "The city has limited capital funding and must balance transportation investments against other municipal priorities."
    },
    "objectives": [
      {
        "id": "O1",
        "description": "Improve transportation accessibility for underserved communities.",
        "priority": "high",
        "related_criteria": [
          "C2"
        ]
      },
      {
        "id": "O2",
        "description": "Reduce transportation-related environmental impacts.",
        "priority": "medium",
        "related_criteria": [
          "C3"
        ]
      },
      {
        "id": "O3",
        "description": "Prioritize projects that demonstrate measurable improvements within three years.",
        "priority": "high",
        "related_criteria": [
          "C4"
        ]
      },
      {
        "id": "O4",
        "description": "Maintain responsible use of municipal financial resources.",
        "priority": "high",
        "related_criteria": [
          "C1"
        ]
      },
      {
        "id": "O5",
        "description": "Promote equitable distribution of transportation benefits across neighborhoods.",
        "priority": "high",
        "related_criteria": [
          "C2"
        ]
      }
    ],
    "assumptions": [],
    "constraints": [
      {
        "id": "C1",
        "description": "Individual project implementation cost cannot exceed $15 million.",
        "type": "hard",
        "parameter": "C1",
        "operator": "<=",
        "value": 15,
        "unit": "million USD",
        "scope": "individual_project"
      },
      {
        "id": "C2",
        "description": "Projects should preferably be completed within 36 months.",
        "type": "soft",
        "parameter": "C4",
        "operator": "<=",
        "value": 36,
        "unit": "months",
        "scope": "individual_project"
      },
      {
        "id": "C3",
        "description": "Projects must comply with applicable accessibility requirements.",
        "type": "hard",
        "parameter": "C2",
        "verification_status": "not_evaluated",
        "scope": "individual_project"
      }
    ]
  },
  "resources": {
    "criteria": "../criteria/transport_ai_v1.json",
    "alternatives": "../alternative/transport_core_v1.json",
    "dataset": "../datasets/transport_core_v1.csv",
    "dataset_join_key": "alternative_id"
  },
  "defaults": {
    "pipeline": "ai-mcdm",
    "seed": 123456,
    "repetitions": 1,
    "processing": {
      "weighting": {
        "method": "ahp",
        "parameters": {
          "derivation": "mean"
        }
      },
      "ranking": {
        "method": "topsis",
        "parameters": {
          "normalization": "vector"
        }
      },
      "aggregation": {
        "within_group": "geometric_mean",
        "between_groups": "weighted_geometric_mean",
        "group_power_normalization": "represented_groups",
        "empty_group_policy": "exclude"
      },
      "consistency": {
        "threshold": 0.1,
        "on_exceedance": "retain_and_flag"
      }
    },
    "ai": {
      "enabled": true,
      "repetitions": 1,
      "layers": [
        "data_comprehension",
        "data_explanation_reporting",
        "policy_decision_advisory"
