            "q1": 4,
            "q2": 4,
            "q3": 4,
            "q4": 4,
            "q5": 4,
            "q6": 4
          }
        }
      ],
      "generators": [],
      "combine": "append",
      "on_id_collision": "error"
    }
  },
  "baseline": {
    "case": "S10/control"
  },
  "assertions": [
    {
      "id": "weights_normalized",
