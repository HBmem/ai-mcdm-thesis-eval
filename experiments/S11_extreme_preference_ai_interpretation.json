  "cases": [
    {
      "case_id": "max",
      "name": "MAX numerical evidence with default AI prompts",
      "description": "Every participant submits code 4 for all six questions; the code maps to a ratio of 9. Produce an independent AI interpretation, explanatory report, and policy advice; no prior AI output from the opposite case is supplied.",
      "purpose": "Observe the effect of this numerical evidence condition while keeping prompts and effective model/provider settings fixed to the baseline.",
      "hypothesis": "All participant matrices match within this case, every participant is inconsistent and retained, and session weights differ from the opposite boundary case.",
      "legacy_variant_id": "S02_MAX",
      "result_dependencies": [],
      "operations": [],
      "runtime_operations": [],
      "reuse": {},
      "comparisons": [
        {
          "id": "against_opposite_boundary",
