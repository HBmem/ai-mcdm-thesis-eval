  "baseline": {
    "case": "S10/control"
  },
  "assertions": [
    {
      "id": "weights_normalized",
      "check": "normalized_weights",
      "stage": "calculation",
      "parameters": {},
      "expected": true,
      "severity": "error",
      "atol": 1e-10,
      "rtol": 0
    },
    {
