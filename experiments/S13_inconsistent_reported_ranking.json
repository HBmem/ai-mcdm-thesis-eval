      "rtol": 0
    }
  ],
  "cases": [
    {
      "case_id": "control",
      "name": "Expanded numerical evidence with a reported-ranking intervention",
      "description": "Calculate the expanded dataset normally. In a separate model-facing copy, assign A6 session score 1.0 and rank 1, then renumber other session ranks consistently without changing their scores. Keep all raw performance values, preference evidence, and genuine saved calculations unchanged.",
      "purpose": "Observe spontaneous recognition of a reported-result contradiction with unchanged default prompts at all three AI layers.",
      "hypothesis": "In the genuine calculation, A6 scores no better than the alternatives that dominate it. AI acknowledgement of inconsistency and its effect on explanation and advice are study observations, not numerical pass/fail conditions.",
      "result_dependencies": [],
      "operations": [],
      "runtime_operations": [],
      "reuse": {},
      "comparisons": [
        {
          "id": "against_uniform_ai_baseline",
          "reference": "S10/control",
          "metrics": [
            "weight_delta",
            "score_delta",
            "winner_changed",
            "spearman_rho",
            "kendall_tau_b"
          ],
          "alternative_alignment": "common_ids",
          "criterion_alignment": "require_identical_ids",
          "tie_atol": 1e-12,
          "rerank_common_alternatives": true
        }
      ],
      "assertions": [
        {
          "id": "one_participant_per_group",
          "check": "participant_counts_equal",
          "stage": "calculation",
          "parameters": {
            "counts": {
              "community_residents": 1,
              "transportation_department": 1,
              "city_government": 1,
              "environmental_advocates": 1,
              "business_community": 1
            }
          },
          "expected": true,
          "severity": "error"
        },
        {
          "id": "identical_participant_matrices",
          "check": "all_participant_pairwise_matrices_equal",
          "stage": "calculation",
          "parameters": {},
          "expected": true,
          "severity": "error",
          "atol": 1e-10,
          "rtol": 0
        },
        {
          "id": "zero_participant_inconsistency",
          "check": "all_participant_consistency_ratios",
          "stage": "calculation",
          "parameters": {},
          "expected": 0.0,
          "severity": "error",
          "atol": 1e-10,
          "rtol": 0
        },
        {
          "id": "uniform_group_weights",
