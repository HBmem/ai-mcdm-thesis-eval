{
  "schema_version": "3.0",
  "experiment_id": "S03",
  "name": "Competing Stakeholder Priorities",
  "description": "Competing synthetic stakeholder profiles with equal group voting powers. Ratio judgments are quantized to the same preference-code scale used by S04.",
  "purpose": "Establish heterogeneous stakeholder preferences for examining aggregation and for interpreting subsequent voting-power and participation interventions.",
  "scenario": {
    "id": "transportation_prioritization",
    "description": "Synthetic municipal transportation project selection; no empirical or stakeholder survey claims.",
    "policy_question": "How should a municipal government prioritize transportation improvement initiatives when balancing implementation costs, public accessibility, environmental benefits, and implementation time?"
  },
  "resources": {
    "criteria": "../criteria/transport_v1.json",
    "alternatives": "../alternative/transport_core_v1.json",
    "dataset": "../datasets/transport_core_v1.csv",
    "dataset_join_key": "alternative_id"
  },
  "defaults": {
    "pipeline": "mcdm",
    "seed": 123456,
    "repetitions": 1,
    "processing": {
      "weighting": {
        "method": "ahp",
        "parameters": {
          "derivation": "mean"
        }
      },
      "ranking": {
        "method": "topsis",
        "parameters": {
          "normalization": "vector"
        }
      },
      "aggregation": {
        "within_group": "geometric_mean",
        "between_groups": "weighted_geometric_mean",
        "group_power_normalization": "represented_groups",
        "empty_group_policy": "exclude"
      },
      "consistency": {
        "threshold": 0.1,
        "on_exceedance": "retain_and_flag"
      }
    },
    "ai": {
      "enabled": false,
      "repetitions": 1,
      "layers": [
        "data_comprehension",
        "data_explanation_reporting",
        "policy_decision_advisory"
      ],
      "provider": null,
      "model": null,
      "parameters": {},
      "prompt_overrides": {},
      "reported_result_interventions": []
    }
  },
  "stakeholders": {
    "judgment_encoding": "pairwise_preference",
    "stakeholder_groups": [
      {
        "id": "community_residents",
        "name": "Community Residents",
        "description": "Residents who use or are affected by the city transportation network.",
        "voting_power": 0.2
      },
      {
        "id": "transportation_department",
        "name": "Transportation Department",
        "description": "City staff responsible for transportation planning, operations, and infrastructure.",
        "voting_power": 0.2
      },
      {
        "id": "city_government",
        "name": "City Government",
        "description": "Elected officials and municipal leadership responsible for citywide policy and resource decisions.",
        "voting_power": 0.2
      },
      {
        "id": "environmental_advocates",
        "name": "Environmental Advocates",
        "description": "Advocates focused on environmental impacts and sustainable transportation.",
        "voting_power": 0.2
      },
      {
        "id": "business_community",
        "name": "Business Community",
        "description": "Local businesses and business organizations affected by transportation access and investment.",
        "voting_power": 0.2
      }
    ],
    "participants": {
      "predefined": [
        {
          "participant_id": "community_residents_p01",
          "group_id": "community_residents",
          "judgments": {
            "q1": -2,
            "q2": 0,
            "q3": 0,
            "q4": 2,
            "q5": 2,
            "q6": 0
          }
        },
        {
          "participant_id": "transportation_department_p01",
          "group_id": "transportation_department",
          "judgments": {
            "q1": -1,
            "q2": 0,
            "q3": -1,
            "q4": 1,
            "q5": 0,
            "q6": -1
          }
        },
        {
          "participant_id": "city_government_p01",
          "group_id": "city_government",
          "judgments": {
            "q1": 1,
            "q2": 1,
            "q3": 1,
            "q4": 1,
            "q5": 1,
            "q6": 0
          }
        },
        {
          "participant_id": "environmental_advocates_p01",
          "group_id": "environmental_advocates",
          "judgments": {
            "q1": -1,
            "q2": -3,
            "q3": 0,
            "q4": -2,
            "q5": 1,
            "q6": 3
          }
        },
        {
          "participant_id": "business_community_p01",
          "group_id": "business_community",
          "judgments": {
            "q1": 0,
            "q2": 2,
            "q3": 1,
            "q4": 1,
            "q5": 1,
            "q6": -1
          }
        }
      ],
      "generators": [],
      "combine": "append",
      "on_id_collision": "error"
    },
    "scale_conversion": {
      "from_encoding": "saaty_ratio",
      "method": "nearest_log_distance",
      "tie_break": "closest_to_equal_importance",
      "original_judgments": {
        "community_residents_p01": {
          "q1": 0.25,
          "q2": 1.0,
          "q3": 1.0,
          "q4": 4.0,
          "q5": 4.0,
          "q6": 1.0
        },
        "transportation_department_p01": {
          "q1": 0.5,
          "q2": 1.0,
          "q3": 0.5,
          "q4": 2.0,
          "q5": 1.0,
          "q6": 0.5
        },
        "city_government_p01": {
          "q1": 2.0,
          "q2": 3.0,
          "q3": 3.0,
          "q4": 2.0,
          "q5": 2.0,
          "q6": 1.0
        },
        "environmental_advocates_p01": {
          "q1": 0.5,
          "q2": 0.14285714285714285,
          "q3": 1.0,
          "q4": 0.25,
          "q5": 2.0,
          "q6": 7.0
        },
        "business_community_p01": {
          "q1": 1.0,
          "q2": 4.0,
          "q3": 2.0,
          "q4": 3.0,
          "q5": 2.0,
          "q6": 0.5
        }
      }
    }
  },
  "baseline": {
    "case": "S00/control"
  },
  "assertions": [
    {
      "id": "weights_normalized",
      "check": "normalized_weights",
      "stage": "calculation",
      "parameters": {},
      "expected": true,
      "severity": "error",
      "atol": 1e-10,
      "rtol": 0
    },
    {
      "id": "scores_bounded",
      "check": "bounded_topsis_scores",
      "stage": "calculation",
      "parameters": {},
      "expected": true,
      "severity": "error"
    },
    {
      "id": "valid_judgment_ratios",
      "check": "submitted_values_in_saaty_domain",
      "stage": "calculation",
      "parameters": {},
      "expected": true,
      "severity": "error"
    },
    {
      "id": "reciprocal_matrices",
      "check": "reciprocal_matrices",
      "stage": "calculation",
      "parameters": {},
      "expected": true,
      "severity": "error",
      "atol": 1e-10,
      "rtol": 0
    }
  ],
  "cases": [
    {
      "case_id": "control",
      "name": "Competing stakeholder priorities",
      "description": "One participant per group uses the converted profiles from the S04 control; every group has voting power 0.2.",
      "purpose": "Provide the competing-preference control without requiring another experiment's calculated outputs.",
      "hypothesis": "Group weight vectors differ, and session weights differ from S00; no particular winner or ranking change is required.",
      "legacy_variant_id": "S04",
      "result_dependencies": [],
      "operations": [],
      "runtime_operations": [],
      "reuse": {},
      "comparisons": [
        {
          "id": "against_uniform_preferences",
          "reference": "S00/control",
          "metrics": [
            "weight_delta",
            "score_delta",
            "winner_changed",
            "spearman_rho",
            "kendall_tau_b"
          ],
          "alternative_alignment": "require_identical_ids",
          "criterion_alignment": "require_identical_ids",
          "tie_atol": 1e-12
        }
      ],
      "assertions": [
        {
          "id": "heterogeneous_group_weights",
          "check": "group_weights_all_equal",
          "stage": "calculation",
          "parameters": {},
          "expected": false,
          "severity": "error",
          "atol": 1e-10,
          "rtol": 0
        },
        {
          "id": "different_from_uniform_weights",
          "check": "weights_equal",
          "stage": "comparison",
          "parameters": {
            "reference": "S00/control"
          },
          "expected": false,
          "severity": "error",
          "atol": 1e-10,
          "rtol": 0
        }
      ]
    }
  ],
  "output": {
    "directory": "../results",
    "save_resolved_inputs": true,
    "save_generated_participants": true,
    "save_intermediate_matrices": true,
    "save_per_participant_results": true,
    "save_per_group_results": true,
    "save_topsis_details": true,
    "save_comparisons": true,
    "save_assertion_results": true,
    "save_provenance": true,
    "save_ai_calls": false,
    "save_ai_responses": false
  },
  "target_profiles": {
