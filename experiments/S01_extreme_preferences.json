{
  "schema_version": "3.0",
  "experiment_id": "S01",
  "name": "Extreme pairwise response boundaries",
  "description": "Boundary tests using all-maximum and all-minimum pairwise preference codes with a fixed criterion question order.",
  "purpose": "Verify reciprocal boundaries, consistency warnings, retention of inconsistent judgments, and distinct aggregate preferences at opposite scale extremes.",
  "scenario": {
    "id": "transportation_prioritization",
    "description": "Synthetic municipal transportation project selection; no empirical or stakeholder survey claims.",
    "policy_question": "How should a municipal government prioritize transportation improvement initiatives when balancing implementation costs, public accessibility, environmental benefits, and implementation time?"
  },
  "resources": {
    "criteria": "../criteria/transport_v1.json",
    "alternatives": "../alternative/transport_core_v1.json",
    "dataset": "../datasets/transport_core_v1.csv",
    "dataset_join_key": "alternative_id"
  },
  "defaults": {
    "pipeline": "mcdm",
    "seed": 123456,
    "repetitions": 1,
    "processing": {
      "weighting": {
        "method": "ahp",
        "parameters": {
          "derivation": "mean"
        }
      },
      "ranking": {
        "method": "topsis",
        "parameters": {
          "normalization": "vector"
        }
      },
      "aggregation": {
        "within_group": "geometric_mean",
        "between_groups": "weighted_geometric_mean",
        "group_power_normalization": "represented_groups",
        "empty_group_policy": "exclude"
      },
      "consistency": {
        "threshold": 0.1,
        "on_exceedance": "retain_and_flag"
      }
    },
    "ai": {
      "enabled": false
    }
  },
  "stakeholders": {
    "judgment_encoding": "pairwise_preference",
    "stakeholder_groups": [
      {
        "id": "community_residents",
        "name": "Community Residents",
        "description": "Residents who use or are affected by the city transportation network.",
        "voting_power": 0.2
      },
      {
        "id": "transportation_department",
        "name": "Transportation Department",
        "description": "City staff responsible for transportation planning, operations, and infrastructure.",
        "voting_power": 0.2
      },
      {
        "id": "city_government",
        "name": "City Government",
        "description": "Elected officials and municipal leadership responsible for citywide policy and resource decisions.",
        "voting_power": 0.2
      },
      {
        "id": "environmental_advocates",
        "name": "Environmental Advocates",
        "description": "Advocates focused on environmental impacts and sustainable transportation.",
        "voting_power": 0.2
      },
      {
        "id": "business_community",
        "name": "Business Community",
        "description": "Local businesses and business organizations affected by transportation access and investment.",
        "voting_power": 0.2
      }
    ],
    "participants": {
      "predefined": [
        {
          "participant_id": "community_residents_p01",
          "group_id": "community_residents",
          "judgments": {
            "q1": 4,
            "q2": 4,
            "q3": 4,
            "q4": 4,
            "q5": 4,
            "q6": 4
          }
        },
        {
          "participant_id": "transportation_department_p01",
          "group_id": "transportation_department",
          "judgments": {
            "q1": 4,
            "q2": 4,
            "q3": 4,
            "q4": 4,
            "q5": 4,
            "q6": 4
          }
        },
        {
          "participant_id": "city_government_p01",
          "group_id": "city_government",
          "judgments": {
            "q1": 4,
            "q2": 4,
            "q3": 4,
            "q4": 4,
            "q5": 4,
            "q6": 4
          }
        },
        {
          "participant_id": "environmental_advocates_p01",
          "group_id": "environmental_advocates",
          "judgments": {
            "q1": 4,
            "q2": 4,
            "q3": 4,
            "q4": 4,
            "q5": 4,
            "q6": 4
          }
        },
        {
          "participant_id": "business_community_p01",
          "group_id": "business_community",
          "judgments": {
            "q1": 4,
            "q2": 4,
            "q3": 4,
            "q4": 4,
            "q5": 4,
            "q6": 4
          }
        }
      ],
      "generators": [],
      "combine": "append",
      "on_id_collision": "error"
    }
  },
  "baseline": {
    "case": "S01/max"
  },
  "assertions": [
    {
      "id": "weights_normalized",
      "check": "normalized_weights",
      "stage": "calculation",
      "parameters": {},
      "expected": true,
      "severity": "error",
      "atol": 1e-10,
      "rtol": 0
    },
    {
      "id": "scores_bounded",
      "check": "bounded_topsis_scores",
      "stage": "calculation",
      "parameters": {},
      "expected": true,
      "severity": "error"
    },
    {
      "id": "valid_judgment_ratios",
      "check": "submitted_values_in_saaty_domain",
      "stage": "calculation",
      "parameters": {},
      "expected": true,
      "severity": "error"
    },
    {
      "id": "reciprocal_matrices",
      "check": "reciprocal_matrices",
      "stage": "calculation",
      "parameters": {},
      "expected": true,
      "severity": "error",
      "atol": 1e-10,
      "rtol": 0
    }
  ],
  "cases": [
    {
      "case_id": "max",
      "name": "All MAX responses",
      "description": "Every participant submits code 4 for all six questions; the code maps to a ratio of 9.",
      "purpose": "Test the corresponding scale boundary without reversing the configured question order.",
      "hypothesis": "All participant matrices match within this case, every participant is inconsistent and retained, and session weights differ from the opposite boundary case.",
      "legacy_variant_id": "S02_MAX",
      "result_dependencies": [],
      "operations": [],
      "runtime_operations": [],
      "reuse": {},
      "comparisons": [
        {
          "id": "against_opposite_boundary",
          "reference": "S01/min",
          "metrics": [
            "weight_delta",
            "score_delta",
            "winner_changed",
            "spearman_rho",
            "kendall_tau_b"
          ],
          "alternative_alignment": "require_identical_ids",
          "criterion_alignment": "require_identical_ids",
          "tie_atol": 1e-12
        }
      ],
      "assertions": [
        {
          "id": "identical_participant_matrices",
          "check": "all_participant_pairwise_matrices_equal",
          "stage": "calculation",
          "parameters": {},
          "expected": true,
          "severity": "error",
          "atol": 1e-10,
          "rtol": 0
        },
        {
          "id": "all_participants_inconsistent",
          "check": "inconsistent_participant_count",
          "stage": "calculation",
          "parameters": {},
          "expected": 5,
          "severity": "error"
        },
        {
          "id": "inconsistent_inputs_retained",
          "check": "inconsistent_inputs_retained_and_flagged",
          "stage": "calculation",
          "parameters": {},
          "expected": true,
          "severity": "error"
        },
        {
          "id": "opposite_weights_distinct",
          "check": "weights_equal",
          "stage": "comparison",
          "parameters": {
            "reference": "S01/min"
          },
          "expected": false,
          "severity": "error",
          "atol": 1e-10,
          "rtol": 0
        },
        {
          "id": "external_reference_comparison",
          "check": "computed_results_match_independent_reference_per_variant",
          "stage": "calculation",
          "parameters": {},
          "expected": true,
          "severity": "error",
          "deferred": true,
          "reason": "Comparison against external PoliInsight results remains outside the independent reference experiment."
        }
      ]
    },
    {
      "case_id": "min",
      "name": "All MIN responses",
      "description": "Every participant submits code -4 for all six questions; the code maps to a ratio of 0.1111111111111111.",
      "purpose": "Test the corresponding scale boundary without reversing the configured question order.",
      "hypothesis": "All participant matrices match within this case, every participant is inconsistent and retained, and session weights differ from the opposite boundary case.",
      "legacy_variant_id": "S02_MIN",
