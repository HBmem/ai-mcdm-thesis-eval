      "rtol": 0
    }
  ],
  "cases": [
    {
      "case_id": "remove_winner",
      "name": "Remove baseline winners while preserving weights",
      "description": "Use the same explicit stakeholder inputs and resources as S01/control. Wait for its numerical results, remove every alternative tied for its highest TOPSIS score within an absolute tolerance of 1e-12, and reuse its criterion weights. Fail the case if removal would leave no alternatives.",
      "purpose": "Isolate the effect of changing the alternative set on TOPSIS normalization, scores, and the relative ranking of surviving alternatives.",
      "hypothesis": "The resolved alternative set equals the S00 alternative set minus its winner set; participant judgments, group weights, and applied criterion weights are preserved. Score changes and rank reversals among survivors are measured without requiring either to occur.",
      "result_dependencies": [
        "S00/control"
      ],
      "operations": [],
      "runtime_operations": [
        {
          "type": "remove_winner",
          "reference": "S00/control",
          "tie_policy": "remove_all_winners",
          "tie_atol": 1e-12,
          "on_empty_alternatives": "error"
        }
      ],
      "reuse": {
        "criterion_weights": {
          "reference": "S00/control",
          "scopes": [
            "participant",
            "group",
            "session"
          ],
          "criterion_alignment": "require_identical_ids"
        }
      },
      "comparisons": [
        {
          "id": "against_baseline_survivors",
          "reference": "S00/control",
          "metrics": [
            "weight_delta",
            "score_delta",
            "spearman_rho",
            "kendall_tau_b"
          ],
          "alternative_alignment": "common_ids",
          "criterion_alignment": "require_identical_ids",
          "rerank_common_alternatives": true,
          "tie_atol": 1e-12
        }
      ],
      "assertions": [
        {
          "id": "only_baseline_winners_removed",
          "check": "alternative_ids_equal_reference_without_winners",
          "stage": "comparison",
          "parameters": {
            "reference": "S00/control",
            "tie_atol": 1e-12
          },
          "expected": true,
          "severity": "error"
        },
        {
          "id": "judgments_preserved",
          "check": "participant_judgments_equal",
          "stage": "comparison",
          "parameters": {
            "reference": "S00/control"
          },
          "expected": true,
          "severity": "error"
        },
        {
          "id": "group_preferences_preserved",
          "check": "group_weights_equal",
          "stage": "comparison",
          "parameters": {
            "reference": "S00/control"
          },
          "expected": true,
          "severity": "error",
          "atol": 1e-10,
          "rtol": 0
        },
        {
          "id": "criterion_weights_preserved",
          "check": "weights_equal",
          "stage": "comparison",
          "parameters": {
            "reference": "S00/control"
          },
          "expected": true,
          "severity": "error",
          "atol": 1e-10,
          "rtol": 0
        }
      ]
    }
  ],
