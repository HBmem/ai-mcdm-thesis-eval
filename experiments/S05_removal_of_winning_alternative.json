{
  "schema_version": "3.0",
  "experiment_id": "S05",
  "name": "Removal of Winning Alternative",
  "description": "Run the uniform-preference S00 control, remove its complete TOPSIS winner set, and rerank the remaining alternatives using the same criterion weights and vector normalization over the reduced decision matrix.",
  "purpose": "Measure how removing the baseline winner changes scores and relative ordering among surviving alternatives while keeping stakeholder judgments, criterion definitions, and applied criterion weights fixed.",
  "scenario": {
    "id": "transportation_prioritization",
    "description": "Synthetic municipal transportation project selection; no empirical or stakeholder survey claims.",
    "policy_question": "How should a municipal government prioritize transportation improvement initiatives when balancing implementation costs, public accessibility, environmental benefits, and implementation time?"
  },
  "resources": {
    "criteria": "../criteria/transport_v1.json",
    "alternatives": "../alternative/transport_core_v1.json",
    "dataset": "../datasets/transport_core_v1.csv",
    "dataset_join_key": "alternative_id"
  },
  "defaults": {
    "pipeline": "mcdm",
    "seed": 123456,
    "repetitions": 1,
    "processing": {
      "weighting": {
        "method": "ahp",
        "parameters": {
          "derivation": "mean"
        }
      },
      "ranking": {
        "method": "topsis",
        "parameters": {
          "normalization": "vector"
        }
      },
      "aggregation": {
        "within_group": "geometric_mean",
        "between_groups": "weighted_geometric_mean",
        "group_power_normalization": "represented_groups",
        "empty_group_policy": "exclude"
      },
      "consistency": {
        "threshold": 0.1,
        "on_exceedance": "retain_and_flag"
      }
    },
    "ai": {
      "enabled": false,
      "repetitions": 1,
