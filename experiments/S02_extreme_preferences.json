    "expected_assertions": [
        {
            "id": "B1",
            "check": "submitted_values_in_saaty_domain",
            "expected": true
        },
        {
            "id": "B2",
            "check": "reciprocal_matrices",
            "expected": true
        },
        {
            "id": "B3",
            "check": "all_participants_identical_within_each_variant",
            "expected": true
        },
        {
            "id": "B4",
            "check": "all_participants_CR_exceeds_warning_threshold_in_each_variant",
            "expected": true
        },
        {
            "id": "B5",
            "check": "inconsistent_inputs_retained_and_flagged",
            "expected": true
        },
        {
            "id": "B6",
            "check": "computed_results_match_independent_reference_per_variant",
            "expected": true,
            "deferred": true
        },
        {
            "id": "B7",
            "check": "max_and_min_variants_have_distinct_aggregate_weights",
            "expected": true
        }
    ],
    "ai_evaluation": {
        "questions": [
            "What does a MAX or MIN response mean given the fixed order of each pair?",
            "Are these extreme but internally consistent preference patterns?",
            "Were inconsistent inputs retained and flagged?",
            "How do the two resulting criterion-weight vectors and rankings differ?"
        ],
        "required_claims": [
            "9 and 1/9 reverse the direction of a pairwise comparison.",
            "A pattern of all 9s or all 1/9s on the six upper-triangle questions is generally inconsistent for four criteria.",
            "The input policy retains judgments and flags consistency warnings.",
            "Numerical weight or rank comparisons must come from the actual run."
        ],
        "prohibited_claims": [
            "Extreme intensity necessarily indicates consistency.",
            "Any participant was excluded because CR was too high.",
            "A fabricated rank change."
        ]
    },
    "output": {
        "directory": "../results/S02",
