					"q5": 1.0,
					"q6": 1.0
				}
			}
		}
	},
	"baseline": {
		"case": "S00/control"
	},
	"assertions": [
		{
			"id": "weights_normalized",
			"check": "normalized_weights",
			"stage": "calculation",
			"parameters": {},
			"expected": true,
			"severity": "error",
			"atol": 1e-10,
			"rtol": 0
		},
		{
			"id": "scores_bounded",
			"check": "bounded_topsis_scores",
			"stage": "calculation",
			"parameters": {},
			"expected": true,
			"severity": "error"
		},
		{
			"id": "valid_judgment_ratios",
			"check": "submitted_values_in_saaty_domain",
			"stage": "calculation",
			"parameters": {},
			"expected": true,
			"severity": "error"
		},
		{
			"id": "reciprocal_matrices",
			"check": "reciprocal_matrices",
			"stage": "calculation",
			"parameters": {},
			"expected": true,
			"severity": "error",
			"atol": 1e-10,
			"rtol": 0
		}
	],
	"cases": [
		{
			"case_id": "control",
			"name": "Uniform preferences control",
			"description": "One predefined participant per group; every left-to-right criterion importance ratio is 1 and every group has voting power 0.2.",
			"purpose": "Provide the uniform-preference baseline for numerical checks and later experiment comparisons.",
			"hypothesis": "All participant and group matrices are identical, all consistency ratios are zero, and all four session criterion weights are 0.25. Equal criterion importance does not require equal alternative scores.",
			"result_dependencies": [],
			"operations": [],
			"runtime_operations": [],
			"reuse": {},
			"comparisons": [],
			"assertions": [
				{
					"id": "one_participant_per_group",
					"check": "participant_counts_equal",
					"stage": "calculation",
					"parameters": {
						"counts": {
							"community_residents": 1,
							"transportation_department": 1,
							"city_government": 1,
							"environmental_advocates": 1,
							"business_community": 1
						}
					},
					"expected": true,
					"severity": "error"
				},
				{
					"id": "identical_participant_matrices",
					"check": "all_participant_pairwise_matrices_equal",
					"stage": "calculation",
					"parameters": {},
					"expected": true,
					"severity": "error",
					"atol": 1e-10,
					"rtol": 0
				},
				{
					"id": "zero_participant_inconsistency",
					"check": "all_participant_consistency_ratios",
					"stage": "calculation",
					"parameters": {},
					"expected": 0.0,
					"severity": "error",
					"atol": 1e-10,
					"rtol": 0
				},
				{
					"id": "uniform_group_weights",
					"check": "group_weights_equal",
					"stage": "calculation",
					"parameters": {
						"expected_weights": {
							"C1": 0.25,
							"C2": 0.25,
							"C3": 0.25,
							"C4": 0.25
						}
					},
					"expected": true,
					"severity": "error",
					"atol": 1e-10,
					"rtol": 0
				},
				{
					"id": "uniform_session_weights",
					"check": "session_weights_equal",
					"stage": "calculation",
					"parameters": {
						"expected_weights": {
							"C1": 0.25,
							"C2": 0.25,
							"C3": 0.25,
							"C4": 0.25
						}
					},
					"expected": true,
					"severity": "error",
					"atol": 1e-10,
					"rtol": 0
				},
				{
					"id": "neutral_aggregate_matrix",
					"check": "session_aggregate_pairwise_matrix_all_ones",
					"stage": "calculation",
					"parameters": {},
					"expected": true,
					"severity": "error",
					"atol": 1e-10,
					"rtol": 0
				}
			]
		}
	],
	"output": {
		"directory": "../results",
		"save_resolved_inputs": true,
