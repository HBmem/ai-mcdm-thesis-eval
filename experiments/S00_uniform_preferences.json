						"q1": 0,
						"q2": 0,
						"q3": 0,
						"q4": 0,
						"q5": 0,
						"q6": 0
					}
				}
			],
			"generators": [],
			"combine": "append",
			"on_id_collision": "error"
		},
		"scale_conversion": {
			"from_encoding": "saaty_ratio",
			"method": "nearest_log_distance",
			"tie_break": "closest_to_equal_importance",
