  "cases": [
    {
      "case_id": "control",
      "name": "Equal power and equal participation",
      "description": "One predefined participant per group with voting power 0.2 each. The heterogeneous preference profiles from the original S03 and S04 experiments are quantized to the legacy PairwisePreference scale.",
      "purpose": "Establish a local baseline that varies group preferences while holding participation and voting power equal.",
      "hypothesis": "The heterogeneous group judgments produce distinct group weight vectors and a session weight vector different from the uniform-preference S00 control.",
      "result_dependencies": [],
      "operations": [],
      "runtime_operations": [],
      "reuse": {},
      "comparisons": [
        {
          "id": "against_uniform_preferences",
          "reference": "S00/control",
