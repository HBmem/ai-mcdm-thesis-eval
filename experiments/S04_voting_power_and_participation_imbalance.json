{
  "schema_version": "3.0",
  "experiment_id": "S04",
  "name": "Voting Power and Participation Imbalance",
  "description": "Three controlled conditions use the same heterogeneous group preferences and alternative data: equal voting power, unequal voting power, and unequal participant counts at equal voting power. The original ratio judgments are quantized to the legacy PairwisePreference scale; the original ratios are retained in scale_conversion metadata.",
  "purpose": "Separate the effect of assigned group voting power from the effect of repeating identical participants within each group under two-stage geometric aggregation.",
  "scenario": {
    "id": "transportation_prioritization",
    "description": "Synthetic municipal transportation project selection; no empirical or stakeholder survey claims.",
    "policy_question": "How should a municipal government prioritize transportation improvement initiatives when balancing implementation costs, public accessibility, environmental benefits, and implementation time?"
  },
  "resources": {
    "criteria": "../criteria/transport_v1.json",
    "alternatives": "../alternative/transport_core_v1.json",
    "dataset": "../datasets/transport_core_v1.csv",
    "dataset_join_key": "alternative_id"
  },
  "defaults": {
    "pipeline": "mcdm",
    "seed": 123456,
    "repetitions": 1,
    "processing": {
      "weighting": {
        "method": "ahp",
        "parameters": {
          "derivation": "mean"
        }
      },
      "ranking": {
        "method": "topsis",
        "parameters": {
          "normalization": "vector"
        }
      },
      "aggregation": {
        "within_group": "geometric_mean",
        "between_groups": "weighted_geometric_mean",
        "group_power_normalization": "represented_groups",
        "empty_group_policy": "exclude"
      },
      "consistency": {
        "threshold": 0.1,
        "on_exceedance": "retain_and_flag"
      }
    },
    "ai": {
      "enabled": false,
      "repetitions": 1,
      "layers": [
        "data_comprehension",
        "data_explanation_reporting",
        "policy_decision_advisory"
      ],
      "provider": null,
      "model": null,
      "parameters": {},
      "prompt_overrides": {},
      "reported_result_interventions": []
    }
  },
  "stakeholders": {
    "judgment_encoding": "pairwise_preference",
    "stakeholder_groups": [
      {
        "id": "community_residents",
        "name": "Community Residents",
