{
  "schema_version": "3.0",
  "experiment_id": "S09",
  "name": "Inconsistent Stakeholder Judgments",
  "description": "Three inconsistent-judgment interventions distinguish one participant from an entire two-participant group and from all five groups.",
  "purpose": "Verify consistency diagnostics and retention of inconsistent submissions, and measure changes in collective preferences and ranking.",
  "scenario": {
    "id": "transportation_prioritization",
    "description": "Synthetic municipal transportation project selection; no empirical or stakeholder survey claims.",
    "policy_question": "How should a municipal government prioritize transportation improvement initiatives when balancing implementation costs, public accessibility, environmental benefits, and implementation time?"
