  "cases": [
    {
      "case_id": "remove_c1",
      "name": "Remove ranking criterion C1",
      "description": "Omit C1 from ranking, preserve all original AHP questions and evidence, and renormalize S00 weights over the remaining criteria.",
      "purpose": "Isolate the ranking effect of omitting one criterion.",
      "hypothesis": "Each scope applies the restricted and normalized baseline weights; scores and alternative ordering may change.",
      "legacy_variant_id": "S07_C1",
      "result_dependencies": [
        "S00/control"
      ],
      "operations": [],
      "runtime_operations": [
        {
          "type": "remove_criteria",
          "criterion_ids": [
            "C1"
          ],
          "target": "ranking",
          "preserve_preference_evidence": true
        }
      ],
      "reuse": {
        "criterion_weights": {
          "reference": "S00/control",
          "scopes": [
            "participant",
            "group",
            "session"
          ],
          "criterion_alignment": "restrict_and_renormalize"
        }
      },
      "comparisons": [
        {
          "id": "against_full_criteria",
          "reference": "S00/control",
          "metrics": [
            "weight_delta",
            "score_delta",
            "winner_changed",
            "spearman_rho",
            "kendall_tau_b"
          ],
          "alternative_alignment": "require_identical_ids",
          "criterion_alignment": "common_ids",
          "tie_atol": 1e-12
        }
      ],
      "assertions": [
        {
          "id": "criterion_removed_from_ranking",
          "check": "ranking_criterion_ids_equal",
          "stage": "calculation",
          "parameters": {
            "expected_ids": [
