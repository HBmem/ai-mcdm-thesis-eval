{
  "schema_version": "3.0",
  "experiment_id": "S12",
  "name": "Reporting Prompt Intervention",
  "description": "Keep the baseline numerical condition, Data Comprehension prompts, and Policy and Decision Advisory prompts unchanged; replace only the reporting layer task.",
  "purpose": "Observe how one reporting-layer task intervention changes the explanatory report and any downstream policy advice relative to S10.",
  "scenario": {
    "id": "transportation_prioritization",
    "description": "Synthetic municipal transportation project selection; no empirical or stakeholder survey claims.",
    "policy_question": "How should a municipal government prioritize transportation improvement initiatives when balancing implementation costs, public accessibility, environmental benefits, and implementation time?"
  },
  "resources": {
    "criteria": "../criteria/transport_v1.json",
    "alternatives": "../alternative/transport_core_v1.json",
    "dataset": "../datasets/transport_core_v1.csv",
    "dataset_join_key": "alternative_id"
  },
  "defaults": {
    "pipeline": "ai-mcdm",
    "seed": 123456,
    "repetitions": 1,
    "processing": {
      "weighting": {
        "method": "ahp",
        "parameters": {
          "derivation": "mean"
        }
      },
      "ranking": {
        "method": "topsis",
        "parameters": {
          "normalization": "vector"
        }
      },
      "aggregation": {
        "within_group": "geometric_mean",
        "between_groups": "weighted_geometric_mean",
        "group_power_normalization": "represented_groups",
        "empty_group_policy": "exclude"
      },
      "consistency": {
        "threshold": 0.1,
        "on_exceedance": "retain_and_flag"
      }
    },
    "ai": {
      "enabled": true,
      "repetitions": 1,
      "layers": [
        "data_comprehension",
        "data_explanation_reporting",
        "policy_decision_advisory"
      ],
      "provider": null,
      "model": null,
      "parameters": {},
      "prompt_overrides": {
        "data_explanation_reporting": {
          "task": "Produce an evidence-grounded report for policymakers, researchers, technical reviewers, and participating stakeholders using the supplied MCDM results and comprehension records. Distinguish computed findings from interpretation, describe stakeholder agreement and disagreement without claiming population consensus, and state evidence gaps and the limits of supplied robustness tests. Explicitly separate a numerically highest-ranked alternative from a justified policy recommendation. Retain unresolved contradictions and limitations in the report; do not invent missing facts, silently repair data, or infer stakeholder motivations."
        }
      },
      "reported_result_interventions": []
    }
  },
  "stakeholders": {
    "judgment_encoding": "pairwise_preference",
    "stakeholder_groups": [
      {
        "id": "community_residents",
        "name": "Community Residents",
        "description": "Residents who use or are affected by the city transportation network.",
        "voting_power": 0.2
      },
      {
        "id": "transportation_department",
        "name": "Transportation Department",
        "description": "City staff responsible for transportation planning, operations, and infrastructure.",
        "voting_power": 0.2
      },
      {
        "id": "city_government",
        "name": "City Government",
        "description": "Elected officials and municipal leadership responsible for citywide policy and resource decisions.",
        "voting_power": 0.2
      },
      {
        "id": "environmental_advocates",
        "name": "Environmental Advocates",
        "description": "Advocates focused on environmental impacts and sustainable transportation.",
        "voting_power": 0.2
      },
      {
        "id": "business_community",
        "name": "Business Community",
        "description": "Local businesses and business organizations affected by transportation access and investment.",
        "voting_power": 0.2
      }
    ],
    "participants": {
      "predefined": [
        {
          "participant_id": "community_residents_p01",
          "group_id": "community_residents",
          "judgments": {
            "q1": 0,
            "q2": 0,
            "q3": 0,
            "q4": 0,
            "q5": 0,
            "q6": 0
          }
        },
        {
          "participant_id": "transportation_department_p01",
          "group_id": "transportation_department",
          "judgments": {
            "q1": 0,
            "q2": 0,
            "q3": 0,
            "q4": 0,
            "q5": 0,
            "q6": 0
          }
        },
        {
          "participant_id": "city_government_p01",
          "group_id": "city_government",
          "judgments": {
            "q1": 0,
            "q2": 0,
            "q3": 0,
            "q4": 0,
            "q5": 0,
            "q6": 0
          }
        },
        {
          "participant_id": "environmental_advocates_p01",
          "group_id": "environmental_advocates",
          "judgments": {
            "q1": 0,
            "q2": 0,
            "q3": 0,
            "q4": 0,
            "q5": 0,
            "q6": 0
          }
        },
        {
          "participant_id": "business_community_p01",
          "group_id": "business_community",
          "judgments": {
            "q1": 0,
            "q2": 0,
            "q3": 0,
            "q4": 0,
            "q5": 0,
            "q6": 0
          }
        }
      ],
      "generators": [],
      "combine": "append",
      "on_id_collision": "error"
    },
    "scale_conversion": {
      "from_encoding": "saaty_ratio",
      "method": "nearest_log_distance",
      "tie_break": "closest_to_equal_importance",
      "original_judgments": {
        "community_residents_p01": {
          "q1": 1.0,
          "q2": 1.0,
          "q3": 1.0,
          "q4": 1.0,
          "q5": 1.0,
          "q6": 1.0
        },
        "transportation_department_p01": {
          "q1": 1.0,
          "q2": 1.0,
          "q3": 1.0,
          "q4": 1.0,
          "q5": 1.0,
          "q6": 1.0
        },
        "city_government_p01": {
          "q1": 1.0,
          "q2": 1.0,
          "q3": 1.0,
          "q4": 1.0,
          "q5": 1.0,
          "q6": 1.0
        },
        "environmental_advocates_p01": {
          "q1": 1.0,
          "q2": 1.0,
          "q3": 1.0,
          "q4": 1.0,
          "q5": 1.0,
          "q6": 1.0
        },
        "business_community_p01": {
          "q1": 1.0,
          "q2": 1.0,
          "q3": 1.0,
          "q4": 1.0,
          "q5": 1.0,
          "q6": 1.0
        }
      }
    }
  },
  "baseline": {
    "case": "S10/control"
  },
  "assertions": [
    {
      "id": "weights_normalized",
      "check": "normalized_weights",
      "stage": "calculation",
      "parameters": {},
      "expected": true,
      "severity": "error",
      "atol": 1e-10,
      "rtol": 0
    },
    {
      "id": "scores_bounded",
      "check": "bounded_topsis_scores",
      "stage": "calculation",
      "parameters": {},
      "expected": true,
      "severity": "error"
    },
    {
      "id": "valid_judgment_ratios",
      "check": "submitted_values_in_saaty_domain",
      "stage": "calculation",
      "parameters": {},
      "expected": true,
      "severity": "error"
    },
    {
      "id": "reciprocal_matrices",
      "check": "reciprocal_matrices",
      "stage": "calculation",
      "parameters": {},
      "expected": true,
      "severity": "error",
      "atol": 1e-10,
      "rtol": 0
    }
  ],
  "cases": [
    {
      "case_id": "control",
      "name": "Baseline evidence with reporting-task intervention",
      "description": "Use the same numerical inputs as S10/control and replace only the data_explanation_reporting task. The Data Comprehension and Policy and Decision Advisory prompts remain at their defaults.",
      "purpose": "Observe one layer prompt intervention and its downstream consequences, using S10 as the external baseline.",
      "hypothesis": "Numerical inputs and calculated outputs match S10. The report and advisory response may differ; no improvement or particular recommendation is required by this specification.",
      "result_dependencies": [],
      "operations": [],
      "runtime_operations": [],
      "reuse": {},
      "comparisons": [
        {
          "id": "against_default_prompt_baseline",
          "reference": "S10/control",
          "metrics": [
            "weight_delta",
            "score_delta",
            "winner_changed",
            "spearman_rho",
            "kendall_tau_b"
          ],
          "alternative_alignment": "require_identical_ids",
          "criterion_alignment": "require_identical_ids",
          "tie_atol": 1e-12
        }
      ],
      "assertions": [
        {
          "id": "one_participant_per_group",
          "check": "participant_counts_equal",
          "stage": "calculation",
          "parameters": {
            "counts": {
              "community_residents": 1,
              "transportation_department": 1,
              "city_government": 1,
              "environmental_advocates": 1,
              "business_community": 1
            }
          },
          "expected": true,
          "severity": "error"
        },
        {
          "id": "identical_participant_matrices",
          "check": "all_participant_pairwise_matrices_equal",
          "stage": "calculation",
          "parameters": {},
          "expected": true,
          "severity": "error",
          "atol": 1e-10,
          "rtol": 0
        },
        {
          "id": "zero_participant_inconsistency",
          "check": "all_participant_consistency_ratios",
          "stage": "calculation",
          "parameters": {},
          "expected": 0.0,
          "severity": "error",
          "atol": 1e-10,
          "rtol": 0
        },
        {
          "id": "uniform_group_weights",
          "check": "group_weights_equal",
          "stage": "calculation",
          "parameters": {
            "expected_weights": {
              "C1": 0.25,
              "C2": 0.25,
              "C3": 0.25,
              "C4": 0.25
            }
          },
          "expected": true,
          "severity": "error",
          "atol": 1e-10,
          "rtol": 0
        },
        {
          "id": "uniform_session_weights",
          "check": "session_weights_equal",
          "stage": "calculation",
          "parameters": {
            "expected_weights": {
              "C1": 0.25,
              "C2": 0.25,
              "C3": 0.25,
              "C4": 0.25
            }
          },
          "expected": true,
          "severity": "error",
          "atol": 1e-10,
          "rtol": 0
        },
        {
          "id": "neutral_aggregate_matrix",
          "check": "session_aggregate_pairwise_matrix_all_ones",
          "stage": "calculation",
          "parameters": {},
          "expected": true,
          "severity": "error",
          "atol": 1e-10,
          "rtol": 0
        },
        {
          "id": "baseline_weights_preserved",
          "check": "weights_equal",
          "stage": "comparison",
          "parameters": {
            "reference": "S10/control"
          },
          "expected": true,
          "severity": "error",
          "atol": 1e-10,
          "rtol": 0
        },
        {
          "id": "baseline_scores_preserved",
          "check": "scores_equal",
          "stage": "comparison",
          "parameters": {
            "reference": "S10/control"
          },
          "expected": true,
          "severity": "error",
          "atol": 1e-10,
          "rtol": 0
        }
      ]
    }
  ],
  "output": {
    "directory": "../results",
    "save_resolved_inputs": true,
    "save_generated_participants": true,
    "save_intermediate_matrices": true,
    "save_per_participant_results": true,
    "save_per_group_results": true,
    "save_comparisons": true,
    "save_assertion_results": true,
    "save_provenance": true,
