# Copy this file to .env and supply your own values. Never commit credentials.
AI_PROVIDER=openrouter
AI_MODEL=provider/model-name
AI_TIMEOUT_SECONDS=120
AI_MAX_RETRIES=2
AI_RETRY_BASE_SECONDS=1
AI_RETRY_MAX_WAIT_SECONDS=90

OPENROUTER_API_KEY=your-openrouter-api-key

# Keep credentials for other supported providers here if you switch between them.
# OLLAMA_API_KEY=your-ollama-api-key
# OPENAI_API_KEY=your-openai-api-key

# Optional endpoint and OpenRouter attribution overrides.
# AI_BASE_URL=https://openrouter.ai/api/v1
# AI_APP_URL=https://example.com/ai-mcdm-thesis-eval
# AI_APP_NAME=AI MCDM thesis evaluation
